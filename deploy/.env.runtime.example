# Private app/worker environment template. Never commit the filled version.
# Use separate files: worker uses read-only layout/Management and MinIO identities.
TLS_DATABASE_URL=
TLS_MINIO_ENDPOINT=minio:9000
TLS_MINIO_ACCESS_KEY=
TLS_MINIO_SECRET_KEY=
TLS_MINIO_BUCKET=thermal-label-layouts
TLS_MINIO_SECURE=false
TLS_MANAGEMENT_ENABLED=true
TLS_ACTIVITY_ENABLED=true
TLS_MANAGEMENT_KEY_ENCRYPTION=
TLS_STORAGE_INITIALIZE=false
TLS_INTAKE_DATABASE_URL=
TLS_INTAKE_LEDGER_JSON={"database_env":"TLS_INTAKE_DATABASE_URL","active_key":"K1","keys":{"K1":"TLS_INTAKE_HMAC_K1"}}
TLS_INTAKE_HMAC_K1=
TLS_QUEUE_ENABLED=true
TLS_QUEUE_KEYS_JSON={"active":"Q1","keys":{"Q1":"TLS_QUEUE_KEY_Q1"}}
TLS_QUEUE_KEY_Q1=
