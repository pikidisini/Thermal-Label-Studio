{
  "name": "thermal-label-studio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck:core": "tsc -p tsconfig.strict-core.json",
    "preview": "vite preview",
    "test": "tsx --test tests/test_frontend.mjs tests/barcode_payload.mjs tests/snapping_engine.mjs tests/ui_layers.mjs tests/graphics_feature_structure.mjs tests/fixture_simulation.mjs tests/playwright_configuration.mjs tests/studio_preview.mjs",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "record": "playwright codegen http://127.0.0.1:8002/studio --viewport-size=1440,900 --output=tests/browser/ui/recorded_session.spec.js",
    "show-trace": "playwright show-trace",
    "test:e2e:ui": "playwright test --project=ui",
    "test:e2e:integration": "playwright test --project=integration"
  },
  "dependencies": {
    "fabric": "^7.4.0",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "c8": "^12.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vite": "^6.1.0"
  }
}
