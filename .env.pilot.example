# ==============================================================================
# Thermal Label Studio — Pilot Environment Template (.env.pilot.example)
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to '.env' before running docker compose:
#    cp .env.pilot.example .env
# 2. In production or live pilot, REPLACE the placeholder passwords and secrets!
# 3. DO NOT commit the resulting '.env' file into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Service Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=thermal_label_pilot
POSTGRES_USER=pilot_user
POSTGRES_PASSWORD=pilot_password_replace_in_production
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Application & Control Plane Configuration
# ------------------------------------------------------------------------------
# Port exposed on the host for FastAPI Control Plane and React UI
APP_PORT=8000

# Enable print agent pipeline with PostgreSQL persistence (ADR-014, ADR-015)
PRINT_AGENT_ENABLED=true
PRINT_AGENT_REPOSITORY_BACKEND=postgresql

# Database connection URL for FastAPI app and migration commands inside containers.
# NOTE: Uses the Docker Compose service hostname 'db' and credentials configured above.
PRINT_AGENT_DATABASE_URL=postgresql://pilot_user:pilot_password_replace_in_production@db:5432/thermal_label_pilot

# PostgreSQL connection pool sizing
PRINT_AGENT_DATABASE_POOL_MIN_SIZE=2
PRINT_AGENT_DATABASE_POOL_MAX_SIZE=10

# Durable artifact storage directory (mounted to persistent volume artifact_data)
# Absolute path inside the Linux container (ADR-011, B2B2D)
PRINT_AGENT_ARTIFACT_ROOT=/app/artifacts

# Default label rendering resolution in DPI
DEFAULT_DPI=203.2

# ------------------------------------------------------------------------------
# Central Print Dispatcher Worker Configuration (B2B2E, B2B2F)
# ------------------------------------------------------------------------------
# Site identifier matching the physical facility / line
PILOT_SITE_ID=pilot-site

# Unique identifier for this central dispatcher instance
PILOT_DISPATCHER_ID=central-dispatcher-1

# Polling interval in seconds when the queue is idle
DISPATCHER_POLL_INTERVAL_SECONDS=2.0

# Active lease duration in seconds for claimed print jobs
DISPATCHER_LEASE_SECONDS=30

# Network TCP socket connect/send timeout in seconds for printer communication
DISPATCHER_SOCKET_TIMEOUT=10.0

# ------------------------------------------------------------------------------
# Pilot Line 1 Printer Registration Defaults (for seed_pilot helper)
# ------------------------------------------------------------------------------
PILOT_PRINTER_ID=PRN-PILOT-01
PILOT_PRINTER_HOST=192.168.1.50
PILOT_PRINTER_PORT=9100
PILOT_PRINTER_BRAND=HONEYWELL
PILOT_PRINTER_MODEL=PD45S
PILOT_PRINTER_LANGUAGE=ipl
PILOT_PRINTER_EMULATION=native
PILOT_PRINTER_DPI=203.0
PILOT_AREA_ID=packing-line-1
