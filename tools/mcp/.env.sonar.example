# Copy to .env.sonar after creating a dedicated read-only SonarQube user and USER token.
# .env.sonar is ignored. Do not commit real credentials.
SONARQUBE_TOKEN=replace-with-user-token
SONARQUBE_URL=http://host.docker.internal:9004
SONARQUBE_READ_ONLY=true
SONARQUBE_TOOLSETS=issues,quality-gates,rules,measures,coverage
SONARQUBE_LOG_TO_FILE_DISABLED=true
TELEMETRY_DISABLED=true
