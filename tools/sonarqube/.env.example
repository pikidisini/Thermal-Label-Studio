# Copy to .env. Do not commit the copied file.
# Generate a unique password and a base64-encoded JWT secret for this local stack.
SONAR_DB_PASSWORD=replace-with-a-long-random-password
SONAR_AUTH_JWTBASE64HS256SECRET=replace-with-a-base64-encoded-random-secret
# SonarQube is intentionally loopback-only. Port 9000 is not used because it is
# already reserved on this workstation.
SONAR_HOST_PORT=9004
