# Copy to .env and set the exact existing Jenkins home volume name from the
# Docker volume inventory. The Compose file declares it external and will not
# create, remove, or reset it.
TLS_JENKINS_HOME_VOLUME=thermal-label-jenkins-local_jenkins_home
JENKINS_HOST_PORT=8081
# An absolute host path is preferable if Compose is invoked outside this folder.
# The default ../../ resolves to web_app when this compose file is used.
TLS_WORKSPACE_PATH=../..
