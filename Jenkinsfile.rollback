pipeline {
    agent any
    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timestamps()
        timeout(time: 10, unit: 'MINUTES')
    }
    stages {
        stage('Checkout trusted main') {
            steps {
                deleteDir()
                checkout scm
            }
        }
        stage('Restore previous local image') {
            steps {
                sh 'docker image inspect tls-local-sim:previous >/dev/null'
                withCredentials([string(credentialsId: 'tls-pilot-operator-secret', variable: 'PILOT_OPERATOR_SECRET')]) {
                    sh 'bash ops/jenkins/deploy-local.sh tls-local-sim:previous'
                }
            }
        }
    }
}
