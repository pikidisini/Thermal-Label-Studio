# Thermal Label Studio - Environment Configuration Example
# Salin berkas ini menjadi '.env' di mesin lokal Anda untuk mengonfigurasi runtime.
# JANGAN MENYIMPAN password nyata, token, atau secret di berkas contoh ini atau Git.

# Pengaturan Server
HOST=0.0.0.0
PORT=8000
STORAGE_BACKEND=filesystem
# Set STORAGE_BACKEND=minio to opt in. The app fails closed if these are invalid.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_ARTIFACT_BUCKET=thermal-label
MINIO_TEMPLATE_BUCKET=thermal-label
DEFAULT_DPI=203.2

# Local development must stay simulation-only; physical routes remain unavailable.
LOCAL_SIMULATION_ONLY=true

# Legacy physical print compatibility bridge (default disabled; IT + CSRF required when enabled)
LEGACY_DIRECT_PRINT_ENABLED=false

# Mode Safe Demo & Simulasi SAP (Default aman: nonaktif / false)
SAFE_DEMO_MODE=false
SAP_SHADOW_SIMULATION_ENABLED=false

# Mode Operator Pilot Mandiri (Default aman: nonaktif / false)
PILOT_OPERATOR_ENABLED=false

# Kata sandi rahasia operator (Wajib diisi pada berkas .env lokal jika PILOT_OPERATOR_ENABLED=true)
# PILOT_OPERATOR_PASSWORD=
# PILOT_SESSION_TTL_SECONDS=3600

# Token Autentikasi Mesin SAP Shadow (Opsional untuk integrasi headless mesin SAP DEV)
# SAP_SIMULATION_AUTH_TOKEN=
