# Copy to .env in the project root and fill the required values.
# .env is ignored by Git/Docker. Never commit real credentials.
# Compose loads .env; Python receives explicitly mapped environment variables.
RESVG_SHA256=
TLS_APP_PORT=8002
# Account login is mandatory. Provision 008_auth.sql and bootstrap explicitly.
# Comma-separated exact browser origins, without trailing slash; HTTPS for LAN.
TLS_AUTH_ORIGINS=
# Explicit localhost development only. Never permits non-loopback HTTP clients.
TLS_AUTH_LOCAL_HTTP=false
# Numeric reverse-proxy peer IPs only; empty means forwarded headers are ignored.
TLS_TRUSTED_PROXY_IPS=
# Use a URL-safe password because Compose embeds it in the PostgreSQL DSN.
TLS_DB_PASSWORD=
TLS_MINIO_ACCESS_KEY=
TLS_MINIO_SECRET_KEY=
# Preserve existing local data identities. For a fresh target, explicitly
# provision the selected external volumes before the first start.
TLS_POSTGRES_VOLUME=thermal-label-studio-p8c_p8c-postgres
TLS_MINIO_VOLUME=thermal-label-studio-p8c_p8c-minio

# Optional print default. Leave empty when targets are entered in the Print dialog.
# Explicit dialog target overrides this default for one request. Delivery needs named-target authorization.
# TLS_PRINTER_HOST=192.168.88.84
TLS_PRINTER_HOST=
TLS_PRINTER_PORT=9100

# External intake is denied without an explicit server-owned policy and bearer secrets.
# T09 source only: do not enable intake print or provision real tokens here.
# Python does not read .env; runtime must explicitly map these variables (T11).
# See docs/implementation/universal-label-pipeline/T09_POLICY_OPERATIONS.md.
TLS_INTAKE_POLICY_JSON=
# Optional local Application Management. Requires separately provisioned
# backend/schema/003_management.sql and a seeded management_state snapshot.
# false: environment policy remains authoritative; management is read-only.
# true: PostgreSQL management policy is authoritative; failures deny intake.
TLS_MANAGEMENT_ENABLED=false
# Operational history: provision backend/schema/004_activity_log.sql on the
# authorized Studio database before enabling. Independent of management audit.
TLS_ACTIVITY_ENABLED=false
# Persistent base64url encoding of 32 random bytes. Keep outside the database;
# preserve securely with backups. Changing it makes existing encrypted keys unreadable.
TLS_MANAGEMENT_KEY_ENCRYPTION=
# TLS_INTAKE_TOKEN_<SOURCE>= (ignored runtime secret, base64url alphabet, 32..256 characters)

# Optional dedicated intake ledger; blank disables runtime wiring. Never generate
# ephemeral keys at startup, reuse sender credentials, or drop old tombstone keys.
# JSON contains references only, e.g. {"database_env":"TLS_INTAKE_DATABASE_URL","active_key":"k1","keys":{"k1":"TLS_INTAKE_HMAC_K1"}}
# Schema backend/schema/002_label_intake.sql requires separate named authorization.
TLS_INTAKE_LEDGER_JSON=
TLS_INTAKE_DATABASE_URL=
# Canonical unpadded base64url of 32..64 random bytes. No sample operational key.
TLS_INTAKE_HMAC_K1=
# Compose maps K1 explicitly; add explicit mappings for retained rotation keys.

# Optional host RFC worker. Install/verify a compatible PyRFC + SAP NW RFC SDK
# runtime separately. Never put credentials here; SAP Connections owns them.
TLS_SAP_RFC_ENABLED=false
TLS_SAP_RFC_PYTHON=
# Exact host/client entries and exact function names, separated with semicolons.
TLS_SAP_RFC_TARGETS=
TLS_SAP_RFC_FUNCTIONS=
